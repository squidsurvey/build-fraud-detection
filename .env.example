# ── Database ──────────────────────────────────────────────────────────────
# Puerto del HOST: 15432 (evita conflicto con postgres nativo en 5432)
POSTGRES_DB=frauddb
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change_me_in_production

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production

# ── API ───────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_32_chars_minimum_in_production
API_DEBUG=false

# ── n8n ───────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=change_me_in_production
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://n8n:5678/webhook/fraud-alert

